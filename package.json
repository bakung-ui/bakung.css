{
  "name": "@bakung-ui/bakung.css",
  "description": "HTML UI library pure CSS, lightweight, no javascript",
  "version": "26.1.2",
  "keywords": [
    "css",
    "css-library",
    "css-ui",
    "css-theme",
    "pure-css",
    "css-only",
    "lightweight-css"
  ],
  "author": "Tria Warman @triawarman",
  "style": "dist/bakung.min.css",
  "exports": {
    "unpkg": "./dist/bakung.min.css",
    "style": "./dist/bakung.min.css"
  },
  "files": [
    "css",
    "dist",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE.md",
    "README.md"
  ],
  "license": "MIT",
  "homepage": "https://bakung-ui.github.io/bakung.css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bakung-ui/bakung.css.git"
  },
  "bugs": "https://github.com/bakung-ui/bakung.css/issues",
  "devDependencies": {
    "@bakung-ui/minimax.css": "^26.1.3",
    "cssnano": "^7.1.2",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-discard-comments": "^7.0.5",
    "postcss-import": "^16.1.1"
  },
  "scripts": {
    "build:_bakungMinify": "postcss css/_bakung.css > dist/_bakung.min.css --use cssnano --no-map",
    "build:combine": "postcss css/_bakung.css -o dist/bakung.css --use postcss-import --use postcss-discard-comments --no-map",
    "build:minify": "postcss dist/bakung.css > dist/bakung.min.css --no-map",
    "build": "npm run build:_bakungMinify && npm run build:combine && npm run build:minify --importDep noimport"
  },
  "engines": {
    "node": ">=v22.16.0",
    "npm": ">=10.9.2"
  },
  "packageManager": "yarn@4.12.0"
}
