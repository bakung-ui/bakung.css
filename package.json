{
  "name": "@bakung-ui/bakung.css",
  "description": "HTML UI library pure CSS, light weight, no javascript",
  "version": "26.1.0",
  "keywords": [
    "css",
    "css-library",
    "css-theme",
    "pure-css",
    "css-only"
  ],
  "author": "Tria Warman @triawarman",
  "files": [
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE.md",
    "README.md",
    "css/_bakung.css",
    "css/_variables.css",
    "dist/_bakung.min.css",
    "dist/bakung.css",
    "dist/bakung.min.css"
  ],
  "license": "MIT",
  "homepage": "https://bakung-ui.github.io/bakung.css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bakung-ui/bakung.css.git"
  },
  "bugs": "https://github.com/bakung-ui/bakung.css/issues",
  "devDependencies": {
    "cssnano": "^7.1.2",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-discard-comments": "^7.0.5",
    "postcss-import": "^16.1.1"
  },
  "scripts": {
    "postcss": "npm run postcss:_minimaxMinify && npm run postcss:combine && npm run postcss:minify --importDep noimport",
    "postcss:_minimaxMinify": "postcss css/_minimax.css > dist/_minimax.min.css --use cssnano --no-map",
    "postcss:combine": "postcss css/_minimax.css -o dist/bakung.css --use postcss-import --use postcss-discard-comments --no-map",
    "postcss:minify": "postcss dist/bakung.css > dist/bakung.min.css --no-map"
  },
  "engines": {
    "node": ">=v22.16.0",
    "npm": ">=10.9.2"
  },
  "packageManager": "yarn@4.12.0"
}
